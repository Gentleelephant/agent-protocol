{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "created_by", "status", "priority", "title", "context", "spec", "artifact_refs", "created_at", "updated_at"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-[0-9]+$"
          },
          "type": {
            "enum": ["review", "feature", "design", "bug"]
          },
          "origin_command": {
            "enum": ["review", "plan", "import"]
          },
          "status": {
            "enum": ["pending", "in_progress", "blocked", "done", "cancelled"]
          },
          "priority": {
            "enum": ["high", "medium", "low"]
          },
          "created_by": {
            "enum": ["agent"]
          },
          "title": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "origin_artifact_id": {
            "type": "string"
          },
          "prompt_artifact_id": {
            "type": "string"
          },
          "source_summary": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_notes": {
            "type": "string"
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_reviewed_at": {
            "type": "string"
          },
          "last_tested_at": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
